{
  "about": "Visual styles: an aesthetic direction (type, color mood, shape, density, motion), never a design system. A style has no components, no tested tokens and no accessibility review of its own, so it is always applied as a brand overlay on a documented system from systems.json. The members are the styles of the author's own research, grouped where they are the same idea; their example values were drafts and are not kept.",
  "styles": [
    {
      "id": "calm-craft",
      "name": "Calm craft (Japanese minimalism)",
      "members": [
        "wabi-sabi-craft",
        "ceramic-minimal-luxe",
        "nordic-hygge"
      ],
      "traits": [
        "generous empty space (ma)",
        "few elements per screen",
        "warm off-white and ink neutrals",
        "serif (mincho) for display, sans (gothic) for interface",
        "asymmetric balance",
        "slow, quiet motion"
      ],
      "fits": [
        "craft",
        "artisan",
        "luxury",
        "hospitality",
        "tea",
        "ceramics",
        "wellness",
        "brand site",
        "portfolio",
        "lifestyle"
      ],
      "avoid_for": [
        "dense tools",
        "dashboards",
        "transactions where people compare many options"
      ],
      "risks": [
        "Low-contrast greys on warm paper fall under WCAG AA: check every text pair",
        "Vertical writing (tategaki, writing-mode: vertical-rl) is for Japanese text only and must fall back to horizontal on narrow screens",
        "Large empty space pushes the primary action below the fold on phones"
      ],
      "carriers": [
        "digital-agency-jp",
        "spindle",
        "radix-themes",
        "material-3"
      ]
    },
